int main(){
        int num ;
        int i;
        int maior = 0;
        
            
        
        for(i = 1; i < 10; i++){
            printf("Digite os dez números ");
            scanf("%d", &num);

            if(num > 50){
               maior++; 
            }
        }
        
        printf("O total de números maiores que 50 são %d", maior);
        return 0;
    }
