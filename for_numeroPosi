#include <stdio.h>

int main(){
        int num ;
        int i;
        int soma = 0;
        
            
        
        for(i = 1; i <=5; i++){
            printf("Digite os cinco números ");
            scanf("%d", &num);

            if(num >= 0){
                soma = soma + num;
            }
            
            else{
                printf("Numero é negativo");
            }
        }
        
        printf("A soma é %d", soma);
        return 0;
    }
